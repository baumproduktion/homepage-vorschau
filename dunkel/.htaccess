# www.tobiasbaum.com -> https://tobiasbaum.com (http -> https erledigt "SSL erzwingen" im KAS)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.tobiasbaum\.com$ [NC]
RewriteRule ^ https://tobiasbaum.com%{REQUEST_URI} [R=301,L]

# Textdateien komprimiert ausliefern
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/plain
</IfModule>
